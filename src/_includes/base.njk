{% set t = translations.fr if lang == 'fr-BE' else translations.nl %}
{% set homeUrl = '/fr/' if lang == 'fr-BE' else '/' %}
{% set treatments = site.treatmentsFr if lang == 'fr-BE' else site.treatments %}
{% set socialImage = site.homeImage.path if home else '/assets/praktijk/181dbf-paardenitaliebanner2.jpg' %}
{% set socialImageAlt = t.homeHeroImage if home else t.heroImage %}
{% set navigation = site.navigationFr if lang == 'fr-BE' else site.navigation %}
<!doctype html>
<html lang="{{ lang or 'nl-BE' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ seoTitle or title }} | {{ site.name }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="theme-color" content="#482c32">
  {% if noindex %}<meta name="robots" content="noindex, follow">{% else %}<meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"><link rel="canonical" href="{{ page.url | absolute }}">{% endif %}
  <meta property="og:type" content="{% if article %}article{% else %}website{% endif %}">
  <meta property="og:site_name" content="{{ t.practicePrefix }} {{ site.name }}">
  <meta property="og:locale" content="{{ (lang or 'nl-BE') | replace('-', '_') }}">
  <meta property="og:title" content="{{ title }} | {{ site.name }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ page.url | absolute }}">
  <meta property="og:image" content="{{ socialImage | absolute }}">
  <meta property="og:image:alt" content="{{ socialImageAlt }}">
  {% for alternate in alternates %}<link rel="alternate" hreflang="{{ alternate.lang }}" href="{{ alternate.url | absolute }}">{% endfor %}
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="{{ '/assets/favicon.svg' | local }}" type="image/svg+xml">
  <link rel="stylesheet" href="{{ '/assets/style.css' | local }}">
  <script type="application/ld+json">{{ schema | json | safe }}</script>
</head>
<body class="{% if home %}is-home{% endif %}">
  <a class="skip" href="#inhoud">{{ t.skip }}</a>
  <div class="topbar"><div class="container"><span>{{ t.tagline }}</span><span class="topbar-links"><a href="{{ ('/fr/urgences/' if lang == 'fr-BE' else '/urgences-spoedgevallen/') | local }}">{{ t.emergency }}</a><a href="tel:{{ site.phoneLink }}">{{ site.phone }} <span aria-hidden="true">↗</span></a></span></div></div>
  <header class="header container">
    <a class="brand" href="{{ homeUrl | local }}" aria-label="Ilse Van Den Broeck — {{ t.home }}">
      <span class="brand-symbol" aria-hidden="true">IVB<span>✳</span></span>
      <span><strong>Ilse Van Den Broeck</strong><small>{{ t.profession }}</small></span>
    </a>
    <nav aria-label="{{ t.navigation }}">{% for item in navigation %}<a href="{{ item.url | local }}" {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.title }}</a>{% endfor %}<a class="language-link" href="{{ (alternateLanguage or t.alternate) | local }}" lang="{{ 'nl' if lang == 'fr-BE' else 'fr' }}">{{ t.language }}</a></nav>
    <a class="button header-cta" href="{{ ('/fr/contact/' if lang == 'fr-BE' else '/contact/') | local }}">{{ t.appointment }} <span aria-hidden="true">↗</span></a>
  </header>
  <main id="inhoud">
  {% if home %}
    <section class="hero container">
      <div class="hero-copy"><p class="eyebrow">{{ t.heroEyebrow }}</p><h1>{{ heading | safe }}</h1><p class="lead">{{ intro }}</p><div class="actions"><a class="button" href="{{ ('/fr/contact/' if lang == 'fr-BE' else '/contact/') | local }}">{{ t.appointment }} <span aria-hidden="true">↗</span></a><a class="text-link" href="{{ ('/fr/diasteme/' if lang == 'fr-BE' else '/afwijkingen/diastema/') | local }}">{{ t.heroMore }} <span aria-hidden="true">→</span></a></div><div class="hero-note"><span aria-hidden="true">✳</span><p>{{ t.heroNote | safe }}</p></div></div>
      <div class="hero-image hero-image--portrait"><img src="{{ site.homeImage.path | local }}" width="{{ site.homeImage.width }}" height="{{ site.homeImage.height }}" alt="{{ t.homeHeroImage }}" fetchpriority="high"><div class="image-label"><span>{{ t.heroLabel }}</span><span aria-hidden="true">↗</span></div><div class="image-stamp">{{ t.heroStamp | safe }} <span aria-hidden="true">✳</span></div></div>
    </section>
    <div class="principles"><div class="container"><span><i aria-hidden="true">01</i> {{ t.principle1 }}</span><span><i aria-hidden="true">02</i> {{ t.principle2 }}</span><span><i aria-hidden="true">03</i> {{ t.principle3 }}</span></div></div>
    <section class="home-content container prose">{{ content | safe }}</section>
  {% else %}
    <div class="page-heading container"><nav class="breadcrumbs" aria-label="{{ 'Fil d’Ariane' if lang == 'fr-BE' else 'Broodkruimel' }}"><a href="{{ homeUrl | local }}">{{ t.home }}</a><span aria-hidden="true">/</span><span>{{ shortTitle or title }}</span></nav><p class="eyebrow">{{ eyebrow or t.profession }}</p><h1>{{ heading or title }}</h1><p class="lead">{{ intro }}</p></div>
    <div class="article-grid container">
      <article class="prose">{% if lastUpdated %}<p class="updated">{{ t.updated }} <time datetime="{{ lastUpdated | isoDate }}">{{ lastUpdated | readableDate(lang) }}</time></p>{% endif %}{{ content | safe }}
      {% if faq %}<section class="faq" id="{{ t.faqId }}"><p class="eyebrow">{{ t.goodToKnow }}</p><h2>{{ t.questions }}</h2>{% for item in faq %}<details><summary>{{ item.question }}</summary><p>{{ item.answer }}</p></details>{% endfor %}</section>{% endif %}
      </article>
      <aside class="sidebar"><span class="eyebrow">{{ t.question }}</span><h2>{{ t.sidebarTitle }}</h2><p>{{ t.sidebarIntro }}</p><a class="button" href="tel:{{ site.phoneLink }}">{{ site.phone }} <span aria-hidden="true">↗</span></a><a class="text-link" href="mailto:{{ site.email }}">{{ t.email }} →</a><hr><p><strong>{{ site.name }}</strong><br>{{ t.profession }}</p><p>{{ site.street }}<br>{{ site.postalCode }} {{ site.city }}, {{ t.country }}</p><a class="text-link" href="{{ site.maps }}">{{ t.route }} ↗</a></aside>
    </div>
  {% endif %}
    <section class="contact-band"><div class="container"><div><p class="eyebrow">{{ t.care }}</p><h2>{{ t.slogan | safe }}</h2></div><a class="button button-light" href="{{ ('/fr/contact/' if lang == 'fr-BE' else '/contact/') | local }}">{{ t.contact }} <span aria-hidden="true">↗</span></a></div></section>
  </main>
  <footer class="footer container"><div><a class="footer-name" href="{{ homeUrl | local }}">Ilse Van Den Broeck</a><p>{{ t.profession }}</p><p>{{ site.street }} · {{ site.postalCode }} {{ site.city }}</p><img class="practice-logo" src="{{ '/assets/praktijk/5bddf9-logoilseveterinaire-dent.jpg' | local }}" width="1200" height="720" alt="{{ t.logo }}" loading="lazy"></div><div><span class="eyebrow">Contact</span><a href="tel:{{ site.phoneLink }}">{{ site.phone }}</a><a href="mailto:{{ site.email }}">{{ site.email }}</a><a href="{{ site.facebook }}">Facebook ↗</a></div><div><span class="eyebrow">{{ t.discover }}</span>{% for item in navigation %}<a href="{{ item.url | local }}">{{ item.title }}</a>{% endfor %}</div><div class="footer-treatments"><span class="eyebrow">{{ t.treatments }}</span><div>{% for item in treatments %}<a href="{{ item.url | local }}">{{ item.title }}</a>{% endfor %}</div></div><div class="footer-bottom"><span>© {{ '' | year }} {{ site.name }} · {{ site.vat }}</span><span><a href="{{ ('/fr/confidentialite/' if lang == 'fr-BE' else '/privacy/') | local }}">{{ t.privacy }}</a> · <a href="{{ ('/fr/plan-du-site/' if lang == 'fr-BE' else '/sitemap/') | local }}">{{ t.sitemap }}</a> · <a href="{{ ('/fr/rss.xml' if lang == 'fr-BE' else '/rss.xml') | local }}">RSS</a> · {{ t.tagline }}</span></div></footer>
</body>
</html>
